# Database Configuration
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:mypassword@localhost:5432/petquest
DATABASE_URL=postgresql://username:password@localhost:5432/petquest

# JWT Secret Key (generate a random string for production)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-this-in-production

# SendGrid API Key (for email functionality)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here

# SendGrid From Email (optional - defaults to lolerpops1@gmail.com if not set)
SENDGRID_FROM_EMAIL=your-email@example.com

# Server Port (optional - defaults to 4000 if not set)
PORT=4000

# Node Environment (optional - set to 'development' or 'production')
NODE_ENV=development